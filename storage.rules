rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Assets uploaded by teachers (images, audios, videos, docs)
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /evidence/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
